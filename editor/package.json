{
  "name": "mlsys-lab",
  "displayName": "mlsys-lab — CUDA, C++ and LLM-systems exercises, auto-graded",
  "description": "Graded exercises in CUDA, C++, Python and LLM systems. Write real CUDA kernels with no NVIDIA GPU: a software GPU counts warps, coalescing transactions, shared-memory bank conflicts and divergence. Deterministic gates, identical score on any machine.",
  "version": "0.1.8",
  "publisher": "mikamika06",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education",
    "Programming Languages",
    "Testing"
  ],
  "activationEvents": [
    "onView:mlsys.bank",
    "onCommand:mlsys.open",
    "workspaceContains:tasks/**/meta.json"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mlsys.open",
        "title": "Open Workspace",
        "category": "mlsys-lab",
        "icon": "$(window)"
      },
      {
        "command": "mlsys.openTask",
        "title": "Open this task",
        "category": "mlsys-lab"
      },
      {
        "command": "mlsys.refresh",
        "title": "Refresh",
        "category": "mlsys-lab",
        "icon": "$(refresh)"
      }
    ],
    "configuration": {
      "title": "mlsys-lab",
      "properties": {
        "mlsys.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python interpreter used to run the grader."
        },
        "mlsys.workDir": {
          "type": "string",
          "default": "",
          "description": "Directory for your solutions, one folder per task. Empty means ~/mlsys-lab. The task bank itself is never written to."
        },
        "mlsys.runTimeoutSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "How long Run lets your code execute before killing it. Grading is unaffected."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mlsys",
          "title": "mlsys-lab",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "mlsys": [
        {
          "id": "mlsys.bank",
          "name": "Task bank"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "mlsys.open",
          "when": "view == mlsys.bank",
          "group": "navigation@1"
        }
      ]
    }
  },
  "keywords": [
    "cuda",
    "gpu",
    "cuda exercises",
    "gpu programming",
    "c++",
    "performance",
    "quantization",
    "llm",
    "kv cache",
    "flash attention",
    "exercises",
    "interview preparation",
    "machine learning systems",
    "simulator",
    "education",
    "coalescing",
    "bank conflicts",
    "simd",
    "numerics",
    "autograder"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/mikamika06/mlsys-lab.git"
  },
  "license": "MIT",
  "icon": "icon.png"
}
