{
  "id": "m-sink-ablation-drop-token-0-and-measure-blowup",
  "title": "Sink Ablation: Drop Token 0",
  "kind": "project",
  "tier": "T1",
  "area": "rw2-kv-cache-serving",
  "track": "kv-cache-compression-eviction",
  "part": 1,
  "difficulty": 2,
  "edits": [
    "sink_ablate/mask.py",
    "sink_ablate/ablation.py",
    "tests/test_regression.py"
  ],
  "milestones": [
    {
      "n": 1,
      "title": "Reconstruct kept-token mask",
      "check": "harness/m1.py",
      "gates": [
        {"metric": "mask_match", "op": "==", "threshold": 1}
      ]
    },
    {
      "n": 2,
      "title": "Ablate token 0 and measure blowup",
      "check": "harness/m2.py",
      "gates": [
        {"metric": "ablation_correct", "op": "==", "threshold": 1},
        {"metric": "blowup_correct", "op": "==", "threshold": 1}
      ]
    },
    {
      "n": 3,
      "title": "Safety net: catch in-place mutation",
      "check": "harness/m3.py",
      "gates": [
        {"metric": "has_tests", "op": "==", "threshold": 1},
        {"metric": "passes_on_good", "op": "==", "threshold": 1},
        {"metric": "catches_inplace", "op": "==", "threshold": 1}
      ]
    }
  ]
}
