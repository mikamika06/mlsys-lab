  "milestones": [
    {
      "n": 1,
      "title": "Detect thrash and classify traces",
      "check": "harness/m1.py",
      "gates": [
        {"metric": "thrash_match", "op": "==", "threshold": 1},
        {"metric": "traces_match", "op": "==", "threshold": 1}
      ]
    },
    {
      "n": 2,
      "title": "Priority scheduling with aging",
      "check": "harness/m2.py",
      "gates": [
        {"metric": "sim_match_no_age", "op": "==", "threshold": 1},
        {"metric": "sim_match_age", "op": "==", "threshold": 1}
      ]
    },
    {
      "n": 3,
      "title": "Safeguard against ignored age factor",
      "check": "harness/m3.py",
      "gates": [
        {"metric": "has_tests", "op": "==", "threshold": 1},
        {"metric": "passes_on_good", "op": "==", "threshold": 1},
        {"metric": "catches_ignored_aging", "op": "==", "threshold": 1}
      ]
    }
  ]
}
