{
  "id": "m-map-20-real-error-transcripts-to-their-failure-class",
  "title": "Local runner troubleshooting and preflight safety checks",
  "kind": "project",
  "tier": "T1",
  "area": "rw3-local-runners",
  "track": "troubleshooting-taxonomy",
  "difficulty": 3,
  "edits": [
    "troubleshoot/mapper.py",
    "troubleshoot/diagnosis.py",
    "troubleshoot/preflight.py",
    "tests/test_regression.py"
  ],
  "milestones": [
    {
      "n": 1,
      "title": "Map error transcripts to failure classes",
      "check": "harness/m1.py",
