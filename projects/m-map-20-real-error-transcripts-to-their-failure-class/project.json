    },
    {
      "n": 2,
      "title": "Extract root cause and fix from logs, ps, and memory counters",
      "check": "harness/m2.py",
      "gates": [{"metric": "diagnoses_correct", "op": ">=", "threshold": 20}]
    },
    {
      "n": 3,
      "title": "Preflight checker and regression test suite",
      "check": "harness/m3.py",
      "gates": [
        {"metric": "has_tests", "op": "==", "threshold": 1},
        {"metric": "passes_on_good", "op": "==", "threshold": 1},
        {"metric": "catches_invalid_preflight", "op": "==", "threshold": 1}
      ]
    }
  ]
}
