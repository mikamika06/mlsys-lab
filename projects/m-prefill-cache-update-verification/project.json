{
  "id": "m-prefill-cache-update-verification",
  "title": "Prefill cache-update verification and on-device memory delta",
  "kind": "project",
  "tier": "T1",
  "area": "rw2-edge-export",
  "track": "Stateful Core ML models and on-device KV cache",
  "part": 1,
  "difficulty": 3,
  "edits": [
    "cacheverify/verify.py",
    "cacheverify/metrics.py",
    "tests/test_regression.py"
  ],
  "milestones": [
    {
      "n": 1,
      "title": "Prefill cache-update verification",
      "check": "harness/m1.py",
      "gates": [
        {
          "metric": "max_abs_err",
          "op": "<=",
          "threshold": 1e-5
        }
      ]
    },
    {
      "n": 2,
      "title": "Stateful vs stateless latency and peak memory delta",
      "check": "harness/m2.py",
      "gates": [
        {
          "metric": "latency_match",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "memory_delta_match",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 3,
      "title": "Safety net: regression test catching bad updates",
      "check": "harness/m3.py",
      "gates": [
        {
          "metric": "has_tests",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "passes_on_good",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "catches_broken_update",
          "op": "==",
          "threshold": 1
        }
      ]
    }
  ]
}
