      "gates": [
        { "metric": "speedup_ok", "op": "==", "threshold": 1.0 },
        { "metric": "speedup_p1_ok", "op": "==", "threshold": 1.0 }
      ]
    },
    {
      "n": 3,
      "title": "взаємодія з розміром батча",
      "check": "harness/m3.py",
      "gates": [
        { "metric": "table_len_ok", "op": "==", "threshold": 1.0 },
        { "metric": "table_vals_ok", "op": "==", "threshold": 1.0 }
      ]
    },
    {
      "n": 4,
      "title": "поріг, за яким вимикати",
      "check": "harness/m4.py",
      "gates": [
        { "metric": "cutoff_ok", "op": "==", "threshold": 1.0 },
        { "metric": "cutoff_zero_ok", "op": "==", "threshold": 1.0 }
      ]
    },
    {
      "n": 5,
      "title": "p95 не гірше базового на жодному режимі",
      "check": "harness/m5.py",
      "gates": [
        { "metric": "p95_ok", "op": "==", "threshold": 1.0 }
      ]
    },
    {
      "n": 6,
      "title": "адаптивна політика з доведеним виграшом",
      "check": "harness/m6.py",
      "gates": [
        { "metric": "has_tests", "op": "==", "threshold": 1.0 },
        { "metric": "passes_on_good", "op": "==", "threshold": 1.0 },
        { "metric": "catches_broken_policy", "op": "==", "threshold": 1.0 }
      ]
    }
  ]
