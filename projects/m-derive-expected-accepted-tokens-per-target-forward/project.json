{
  "id": "m-derive-expected-accepted-tokens-per-target-forward",
  "title": "Deriving expected accepted tokens and optimizing draft max",
  "kind": "project",
  "tier": "T1",
  "area": "rw2-gguf-llamacpp",
  "track": "speculative-decoding-draft",
  "part": 1,
  "difficulty": 3,
  "edits": [
    "specdec/metrics.py",
    "specdec/optimizer.py",
    "tests/test_regression.py"
  ],
  "milestones": [
    {
      "n": 1,
      "title": "Derive expected accepted tokens",
      "check": "harness/m1.py",
      "gates": [
        {
          "metric": "expected_tokens_match",
          "op": ">=",
          "threshold": 3
        }
      ]
    },
    {
      "n": 2,
      "title": "Measure acceptance rate and find optimal draft max",
      "check": "harness/m2.py",
      "gates": [
        {
          "metric": "acceptance_rate_match",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "optimal_max_match",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 3,
      "title": "Safety net: test catching invalid acceptance calculations",
      "check": "harness/m3.py",
      "gates": [
        {
          "metric": "has_tests",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "passes_on_good",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "catches_broken_invariant",
          "op": "==",
          "threshold": 1
        }
      ]
    }
  ]
}
