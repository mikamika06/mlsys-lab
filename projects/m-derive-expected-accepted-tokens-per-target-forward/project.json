{
  "id": "m-derive-expected-accepted-tokens-per-target-forward",
  "title": "Expected accepted tokens and draft length selection",
  "kind": "project",
  "tier": "T1",
  "area": "rw2-gguf-llamacpp",
  "track": "speculative-decoding-draft",
  "part": 1,
  "difficulty": 2,
  "edits": [
    "specdec/metrics.py",
    "specdec/tuning.py",
    "tests/test_regression.py"
  ],
  "milestones": [
    {
      "n": 1,
      "title": "Derive expected accepted tokens from acceptance rates",
      "check": "harness/m1.py",
      "gates": [
        {
          "metric": "acceptance_rel_err",
          "op": "<=",
          "threshold": 1e-05
        },
        {
          "metric": "expected_tokens_rel_err",
          "op": "<=",
          "threshold": 1e-05
        }
      ]
    },
    {
      "n": 2,
      "title": "Pick draft-max maximizing speculative throughput",
      "check": "harness/m2.py",
      "gates": [
        {
          "metric": "optimal_gamma_matched",
          "op": "==",
          "threshold": 1.0
        },
        {
          "metric": "throughput_rel_err",
          "op": "<=",
          "threshold": 1e-05
        }
      ]
    },
    {
      "n": 3,
      "title": "Safety net: test catching latency ignoring bug in draft tuning",
      "check": "harness/m3.py",
      "gates": [
        {
          "metric": "has_tests",
          "op": "==",
          "threshold": 1.0
        },
        {
          "metric": "passes_on_good",
          "op": "==",
          "threshold": 1.0
        },
        {
          "metric": "catches_faulty_throughput",
          "op": "==",
          "threshold": 1.0
        }
      ]
    }
  ]
}
