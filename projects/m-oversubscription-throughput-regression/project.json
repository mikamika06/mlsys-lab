{
  "id": "m-oversubscription-throughput-regression",
  "title": "Oversubscription Throughput Regression and Stream Sweeping",
  "kind": "project",
  "tier": "T1",
  "area": "rw3-cpu-inference",
  "track": "Performance hints & stream/thread scheduling",
  "part": 1,
