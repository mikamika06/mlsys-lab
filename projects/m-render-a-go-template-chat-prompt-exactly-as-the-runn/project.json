{
  "id": "m-render-a-go-template-chat-prompt-exactly-as-the-runn",
  "title": "Local runner chat template rendering and token auditing",
  "kind": "project",
  "tier": "T1",
  "area": "rw3-local-runners",
  "track": "prompt-templating-and-chat-format",
  "part": 1,
  "difficulty": 2,
  "edits": [
    "promptfmt/template.py",
    "promptfmt/tokens.py",
    "promptfmt/gguf.py",
    "tests/test_regression.py"
  ],
  "milestones": [
    {
      "n": 1,
      "title": "Render Go-template chat prompt",
      "check": "harness/m1.py",
      "gates": [
        {
          "metric": "byte_exact_fraction",
          "op": "==",
          "threshold": 1.0
        }
      ]
    },
    {
      "n": 2,
      "title": "Audit tokens and recover GGUF chat templates",
      "check": "harness/m2.py",
      "gates": [
        {
          "metric": "tokens_matched",
          "op": "==",
          "threshold": 1.0
        },
        {
          "metric": "template_match",
          "op": "==",
          "threshold": 1.0
        }
      ]
    },
    {
      "n": 3,
      "title": "Safety net: template regression test",
      "check": "harness/m3.py",
      "gates": [
        {
          "metric": "has_tests",
          "op": "==",
          "threshold": 1.0
        },
        {
          "metric": "passes_on_good",
          "op": "==",
          "threshold": 1.0
        },
        {
          "metric": "catches_broken_template",
          "op": "==",
          "threshold": 1.0
        }
      ]
    }
  ]
}
