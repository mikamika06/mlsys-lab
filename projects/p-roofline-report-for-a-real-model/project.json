{
  "id": "p-roofline-report-for-a-real-model",
  "title": "Roofline-звіт по реальній моделі",
  "kind": "project",
  "tier": "T2",
  "area": "rw3-profiling",
  "track": "roofline-report-for-a-real-model",
  "size": "L",
  "edits": [
    "roofline/models.py",
    "roofline/analysis.py",
    "tests/test_regression.py"
  ],
  "milestones": [
    {
