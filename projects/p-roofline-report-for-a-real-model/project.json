      "gates": [
        {
          "metric": "intensity_matched",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 2,
      "title": "побудувати roofline і розмістити ядра",
      "check": "harness/m2.py",
      "gates": [
        {
          "metric": "perf_matched",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 3,
      "title": "порахувати досяжну стелю для кожного",
      "check": "harness/m3.py",
      "gates": [
        {
          "metric": "ceiling_matched",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 4,
      "title": "оцінити виграш від найкращого оптимізування",
      "check": "harness/m4.py",
      "gates": [
        {
          "metric": "potential_matched",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 5,
      "title": "прогноз збігається з записаним прискореним прогоном",
      "check": "harness/m5.py",
      "gates": [
        {
          "metric": "predict_matched",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 6,
      "title": "звіт із пріоритетами, обґрунтованими числами",
      "check": "harness/m6.py",
      "gates": [
        {
          "metric": "has_tests",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "passes_on_good",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "catches_broken_sort",
          "op": "==",
          "threshold": 1
        }
      ]
    }
  ]
