          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 2,
      "title": "виміряти криву якості по позиції",
      "check": "harness/m2.py",
      "gates": [
        {
          "metric": "curve_computed",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "dip_detected",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 3,
      "title": "відокремити провал уваги від провалу токенізації",
      "check": "harness/m3.py",
      "gates": [
        {
          "metric": "tokenization_isolated",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 4,
      "title": "перевірити на двох методах розширення",
      "check": "harness/m4.py",
      "gates": [
        {
          "metric": "methods_compared",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 5,
      "title": "eval ловить відомий провал",
      "check": "harness/m5.py",
      "gates": [
        {
          "metric": "failure_caught",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 6,
      "title": "набір відтворюється на іншій моделі",
