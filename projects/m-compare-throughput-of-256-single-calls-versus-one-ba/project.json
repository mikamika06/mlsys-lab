    {
      "n": 2,
      "title": "Detect L2 normalization and model mixing impact",
      "check": "harness/m2.py",
      "gates": [
        {"metric": "norm_detected", "op": "==", "threshold": 1},
        {"metric": "mixing_failure_detected", "op": "==", "threshold": 1}
      ]
    },
    {
      "n": 3,
      "title": "Safety net: regression test catching bad embedding validation",
      "check": "harness/m3.py",
      "gates": [
        {"metric": "has_tests", "op": "==", "threshold": 1},
        {"metric": "passes_on_good", "op": "==", "threshold": 1},
        {"metric": "catches_broken_validation", "op": "==", "threshold": 1}
      ]
    }
  ]
