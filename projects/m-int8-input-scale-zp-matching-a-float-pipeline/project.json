{
  "id": "m-int8-input-scale-zp-matching-a-float-pipeline",
  "title": "INT8 input scale/zero-point matching and normalization folding",
  "kind": "project",
  "tier": "T1",
  "area": "rw2-edge-export",
  "track": "IO contract: preprocessing, layout and dtypes at the boundary",
  "part": 1,
  "difficulty": 3,
  "edits": [
    "edgepipe/quant.py",
    "edgepipe/layout.py",
    "edgepipe/export.py",
    "tests/test_regression.py"
  ],
  "milestones": [
    {
      "n": 1,
      "title": "Match INT8 quantization parameters to float pipeline",
      "check": "harness/m1.py",
      "gates": [
        {
          "metric": "params_matched",
          "op": "==",
          "threshold": 1.0
        },
        {
          "metric": "rel_err",
          "op": "<=",
          "threshold": 1e-2
        }
      ]
    },
    {
      "n": 2,
      "title": "Layout conversion and normalization graph folding",
      "check": "harness/m2.py",
      "gates": [
        {
          "metric": "layout_correct",
          "op": "==",
          "threshold": 1.0
        },
        {
          "metric": "folded_match",
          "op": "==",
          "threshold": 1.0
        }
      ]
    },
    {
      "n": 3,
      "title": "Safety net: regression tests for edge pipeline export",
      "check": "harness/m3.py",
      "gates": [
        {
          "metric": "has_tests",
          "op": "==",
          "threshold": 1.0
        },
        {
          "metric": "passes_on_good",
          "op": "==",
          "threshold": 1.0
        },
        {
          "metric": "catches_layout_mismatch",
          "op": "==",
          "threshold": 1.0
        }
      ]
    }
  ]
}
