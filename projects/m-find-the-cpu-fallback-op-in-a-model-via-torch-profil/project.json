      ]
    },
    {
      "n": 2,
      "title": "Measure latency cliff and fallback performance ratio",
      "check": "harness/m2.py",
      "gates": [
        {"metric": "latency_ratio_correct", "op": "==", "threshold": 1}
      ]
    },
    {
      "n": 3,
      "title": "Safety net: regression test catching silent fallback reintroduction",
      "check": "harness/m3.py",
      "gates": [
        {"metric": "has_tests", "op": "==", "threshold": 1},
        {"metric": "passes_on_good", "op": "==", "threshold": 1},
        {"metric": "catches_silent_fallback", "op": "==", "threshold": 1}
      ]
    }
  ]
}
