{
  "id": "p-gguf-container-from-scratch",
  "title": "Свій конвертер у GGUF",
  "kind": "project",
  "tier": "T1",
  "area": "rw2-gguf-llamacpp",
  "track": "gguf-container-format",
  "part": 2,
  "difficulty": 4,
  "requires_pkgs": ["gguf", "numpy"],
  "edits": ["gguf_lab/reader.py", "gguf_lab/writer.py", "tools/inspect_gguf.py", "tests/test_regression.py"],
  "milestones": [
    {"n": 1, "title": "Заголовок і відмова від чужого файлу", "check": "harness/m1.py",
     "gates": [{"metric": "magic_ok", "op": "==", "threshold": 1},
               {"metric": "version_ok", "op": "==", "threshold": 1},
               {"metric": "counts_ok", "op": "==", "threshold": 1},
               {"metric": "rejects_garbage", "op": "==", "threshold": 1}]},
    {"n": 2, "title": "Метадані: усі типи, включно з масивами", "check": "harness/m2.py",
     "gates": [{"metric": "keys_match", "op": "==", "threshold": 1},
               {"metric": "values_match", "op": "==", "threshold": 1},
               {"metric": "types_kept", "op": "==", "threshold": 1}]},
    {"n": 3, "title": "Таблиця тензорів і вирівнювання зсувів", "check": "harness/m3.py",
     "gates": [{"metric": "names_match", "op": "==", "threshold": 1},
               {"metric": "shapes_match", "op": "==", "threshold": 1},
               {"metric": "offsets_aligned", "op": "==", "threshold": 1},
               {"metric": "offsets_increase", "op": "==", "threshold": 1}]},
    {"n": 4, "title": "Дані тензорів байт у байт", "check": "harness/m4.py",
     "gates": [{"metric": "data_matches", "op": "==", "threshold": 1},
               {"metric": "dtype_kept", "op": "==", "threshold": 1},
               {"metric": "missing_raises", "op": "==", "threshold": 1}]},
    {"n": 5, "title": "Твій файл читає справжня бібліотека", "check": "harness/m5.py",
     "gates": [{"metric": "real_reader_accepts", "op": "==", "threshold": 1},
               {"metric": "metadata_survives", "op": "==", "threshold": 1},
               {"metric": "tensors_survive", "op": "==", "threshold": 1}]},
    {"n": 6, "title": "Повний оберт із вирівнюванням 64", "check": "harness/m6.py",
     "gates": [{"metric": "roundtrip_metadata", "op": "==", "threshold": 1},
               {"metric": "roundtrip_tensors", "op": "==", "threshold": 1},
               {"metric": "alignment_honoured", "op": "==", "threshold": 1}]},
    {"n": 7, "title": "Запобіжник: валідатор, що ловить побитий контейнер", "check": "harness/m7.py",
     "gates": [{"metric": "has_tests", "op": "==", "threshold": 1},
               {"metric": "passes_on_good", "op": "==", "threshold": 1},
               {"metric": "catches_truncated", "op": "==", "threshold": 1},
               {"metric": "catches_lying_count", "op": "==", "threshold": 1}]}
  ]
}
