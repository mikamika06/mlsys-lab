{
  "id": "m-bootstrap-confidence-interval-on-recovery",
  "title": "Bootstrap confidence interval on recovery percentage",
  "kind": "project",
  "tier": "T1",
  "area": "rw2-quant-libs",
  "track": "Accuracy evaluation and recovery reporting",
  "part": 1,
  "difficulty": 3,
  "edits": [
    "evalrep/evaluator.py",
    "evalrep/bootstrap.py",
    "evalrep/report.py",
    "tests/test_regression.py"
  ],
  "milestones": [
    {
      "n": 1,
      "title": "Run lm-eval style task evaluation",
      "check": "harness/m1.py",
      "gates": [
        {"metric": "evals_matched", "op": ">=", "threshold": 3}
      ]
    },
    {
      "n": 2,
      "title": "Bootstrap confidence interval on recovery",
      "check": "harness/m2.py",
      "gates": [
        {"metric": "ci_matched", "op": "==", "threshold": 1},
        {"metric": "rel_err", "op": "<=", "threshold": 0.05}
      ]
    },
    {
      "n": 3,
      "title": "Safety net: regression test for bootstrap bounds",
      "check": "harness/m3.py",
      "gates": [
        {"metric": "has_tests", "op": "==", "threshold": 1},
        {"metric": "passes_on_good", "op": "==", "threshold": 1},
        {"metric": "catches_bad_ci", "op": "==", "threshold": 1}
      ]
    }
  ]
}
