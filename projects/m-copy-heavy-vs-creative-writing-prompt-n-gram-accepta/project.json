  "milestones": [
    {
      "n": 1,
      "title": "Analyze n-gram match distribution across prompts",
      "check": "harness/m1.py",
      "gates": [
        {"metric": "distributions_matched", "op": ">=", "threshold": 3}
      ]
    },
    {
      "n": 2,
      "title": "Compute acceptance rates and entropy gap metrics",
      "check": "harness/m2.py",
      "gates": [
        {"metric": "acceptance_rate_match", "op": "==", "threshold": 1},
        {"metric": "entropy_gap_match", "op": "==", "threshold": 1},
        {"metric": "workload_classification_match", "op": "==", "threshold": 1}
      ]
    },
    {
      "n": 3,
      "title": "Safety net: regression test catching flawed acceptance metrics",
      "check": "harness/m3.py",
      "gates": [
        {"metric": "has_tests", "op": "==", "threshold": 1},
        {"metric": "passes_on_good", "op": "==", "threshold": 1},
        {"metric": "catches_broken_metrics", "op": "==", "threshold": 1}
      ]
    }
  ]
}
