{
  "id": "m-copy-heavy-vs-creative-writing-prompt-n-gram-accepta",
  "title": "Copy-heavy vs creative-writing prompt n-gram acceptance gap",
  "kind": "project",
  "tier": "T1",
  "area": "rw3-speculative",
  "track": "N-gram / prompt-lookup decoding",
  "part": 1,
  "difficulty": 3,
  "edits": [
    "ngrameval/analyzer.py",
    "ngrameval/metrics.py",
    "tests/test_regression.py"
