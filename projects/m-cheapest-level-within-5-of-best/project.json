{
  "id": "m-cheapest-level-within-5-of-best",
  "title": "Cheapest ORT Optimization Level Within 5% of Best",
  "kind": "project",
  "tier": "T1",
  "area": "rw2-tensorrt-onnx",
  "track": "ORT graph optimizations: levels, online vs offline, .ort format",
  "part": 1,
  "difficulty": 2,
  "edits": [
    "ortopt/levels.py",
    "ortopt/fused.py",
    "ortopt/costs.py",
