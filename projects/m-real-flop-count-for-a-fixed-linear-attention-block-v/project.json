{
  "id": "m-real-flop-count-for-a-fixed-linear-attention-block-v",
  "title": "Real FLOP count and MFU for a fixed linear-attention block",
  "kind": "project",
  "tier": "T1",
  "area": "rw3-profiling",
  "track": "torch-profiler-flops-and-mfu",
  "part": 1,
  "difficulty": 3,
  "edits": [
    "flopcalc/profiler.py",
    "flopcalc/mfu.py",
    "tests/test_regression.py"
  ],
  "milestones": [
    {
      "n": 1,
      "title": "Real FLOP count via FlopCounterMode",
      "check": "harness/m1.py",
      "gates": [
        {"metric": "flops_matched", "op": "==", "threshold": 1},
        {"metric": "rel_err", "op": "<", "threshold": 0.05}
      ]
    },
    {
      "n": 2,
      "title": "Compute MFU from tokens, parameters, and peak spec",
      "check": "harness/m2.py",
      "gates": [
        {"metric": "mfu_matched", "op": "==", "threshold": 1}
      ]
    },
    {
      "n": 3,
      "title": "Safety net: regression test catching incorrect FLOP scaling",
      "check": "harness/m3.py",
      "gates": [
        {"metric": "has_tests", "op": "==", "threshold": 1},
        {"metric": "passes_on_good", "op": "==", "threshold": 1},
        {"metric": "catches_bad_scaling", "op": "==", "threshold": 1}
      ]
    }
  ]
}
