          "metric": "comparison_match",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "rel_err_bound",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 3,
      "title": "Safety net: regression test for runner divergence",
      "check": "harness/m3.py",
      "gates": [
        {
          "metric": "has_tests",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "passes_on_good",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "catches_divergence",
          "op": "==",
          "threshold": 1
