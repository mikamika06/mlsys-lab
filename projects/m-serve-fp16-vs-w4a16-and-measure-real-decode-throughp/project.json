{
  "id": "m-serve-fp16-vs-w4a16-and-measure-real-decode-throughp",
  "title": "Serve FP16 vs W4A16 and measure real decode throughput",
  "kind": "project",
  "tier": "T3",
  "area": "rw2-vllm-serving",
  "track": "serving-quantization-formats",
  "part": 1,
  "difficulty": 3,
  "edits": [
    "serve/config.py",
    "serve/metrics.py",
    "serve/runner.py",
    "tests/test_regression.py"
  ],
  "milestones": [
    {
      "n": 1,
      "title": "Configure serving profiles for FP16 and W4A16",
      "check": "harness/m1.py",
      "gates": [
        {"metric": "configs_matched", "op": ">=", "threshold": 3}
      ]
    },
    {
      "n": 2,
      "title": "Measure real decode throughput ratio and memory delta",
      "check": "harness/m2.py",
      "gates": [
        {"metric": "throughput_ratio_match", "op": "==", "threshold": 1},
        {"metric": "memory_delta_match", "op": "==", "threshold": 1}
      ]
    },
    {
      "n": 3,
      "title": "Safety net: test catches incorrect throughput calculations",
      "check": "harness/m3.py",
      "gates": [
        {"metric": "has_tests", "op": "==", "threshold": 1},
        {"metric": "passes_on_good", "op": "==", "threshold": 1},
        {"metric": "catches_bad_throughput", "op": "==", "threshold": 1}
      ]
    }
  ]
}
