{
  "id": "l-checkpoint-conversion",
  "title": "Converting a checkpoint: names, shapes, shards and what it costs",
  "kind": "project",
  "tier": "T0",
  "area": "rw2-gguf-llamacpp",
  "track": "Checkpoint formats and cold start",
  "part": 2,
  "difficulty": 4,
  "fixtures": ["_fixtures/gguf", "_fixtures/safetensors", "_fixtures/mlx"],
  "edits": [
