       {"metric": "head_dim_from_metadata", "op": "==", "threshold": 1},
       {"metric": "matches_mlx_layer", "op": "==", "threshold": 1}]},
    {"n": 5, "title": "The plan and the bill", "check": "harness/m5.py",
