       {"metric": "metadata_match", "op": "==", "threshold": 1},
       {"metric": "clean_accepted", "op": "==", "threshold": 1},
       {"metric": "damaged_rejected", "op": "==", "threshold": 1},
       {"metric": "damaged_named", "op": "==", "threshold": 1}]},
    {"n": 2, "title": "The shard index and what it promises", "check": "harness/m2.py",
     "gates": [
       {"metric": "index_loaded", "op": "==", "threshold": 1},
       {"metric": "resolve_match", "op": "==", "threshold": 1},
       {"metric": "clean_index_ok", "op": "==", "threshold": 1},
       {"metric": "catches_missing", "op": "==", "threshold": 1},
       {"metric": "catches_size", "op": "==", "threshold": 1}]},
    {"n": 3, "title": "Every name, including the ones that fan out", "check": "harness/m3.py",
     "gates": [
       {"metric": "llama_complete", "op": "==", "threshold": 1},
       {"metric": "llama_match", "op": "==", "threshold": 1},
