{
  "id": "m-scrape-a-live-server-under-load-and-reconcile-client",
  "title": "Scrape a live server under load and reconcile client-measured p99 with server histograms",
  "kind": "project",
  "tier": "T3",
  "area": "rw2-vllm-serving",
  "track": "observability-metrics-and-tracing",
  "part": 1,
  "difficulty": 3,
  "edits": [
    "vllm_metrics/scraper.py",
    "vllm_metrics/histogram.py",
    "vllm_metrics/reconcile.py",
    "tests/test_regression.py"
  ],
  "milestones": [
    {
      "n": 1,
      "title": "Parse exposition and reconstruct cumulative histograms",
      "check": "harness/m1.py",
      "gates": [
        {
          "metric": "buckets_matched",
          "op": ">=",
          "threshold": 3
        }
      ]
    },
    {
      "n": 2,
      "title": "Interpolate percentiles and reconcile client load divergence",
      "check": "harness/m2.py",
      "gates": [
        {
          "metric": "rel_err_match",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "reconciliation_match",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 3,
      "title": "Safety net: a test that catches corrupted interpolation",
      "check": "harness/m3.py",
      "gates": [
        {
          "metric": "has_tests",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "passes_on_good",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "catches_bad_interpolation",
          "op": "==",
          "threshold": 1
        }
      ]
    }
  ]
}
