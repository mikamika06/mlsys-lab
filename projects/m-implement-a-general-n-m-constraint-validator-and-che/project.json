        {
          "metric": "validators_matched",
          "op": ">=",
          "threshold": 3
        }
      ]
    },
    {
      "n": 2,
      "title": "Check real execution masks and index layouts",
      "check": "harness/m2.py",
      "gates": [
        {
          "metric": "masks_matched",
          "op": ">=",
          "threshold": 3
        }
      ]
    },
    {
      "n": 3,
      "title": "Safety net: test catching relaxed or invalid mask structures",
      "check": "harness/m3.py",
      "gates": [
        {
          "metric": "has_tests",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "passes_on_good",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "catches_invalid_masks",
          "op": "==",
          "threshold": 1
        }
      ]
    }
  ]
