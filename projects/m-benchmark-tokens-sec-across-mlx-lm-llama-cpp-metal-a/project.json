      "check": "harness/m2.py",
      "gates": [
        {"metric": "rss_matched", "op": "==", "threshold": 1},
        {"metric": "summary_matched", "op": "==", "threshold": 1}
      ]
    },
    {
      "n": 3,
      "title": "Safety net: test suite catching corrupted decode timings",
      "check": "harness/m3.py",
      "gates": [
        {"metric": "has_tests", "op": "==", "threshold": 1},
        {"metric": "passes_on_good", "op": "==", "threshold": 1},
        {"metric": "catches_flawed_benchmark", "op": "==", "threshold": 1}
      ]
    }
  ]
