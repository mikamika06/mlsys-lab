{
  "id": "m-per-dtype-tolerance-gate",
  "title": "Per-dtype tolerance gate and divergence bisection",
  "kind": "project",
  "tier": "T1",
  "area": "rw2-pytorch-applied",
  "track": "Numerical validation and performance regression gating",
  "part": 1,
  "difficulty": 3,
  "edits": [
    "tolgate/tolerance.py",
    "tolgate/bisection.py",
    "tests/test_regression.py"
  ],
  "milestones": [
    {
      "n": 1,
      "title": "Per-dtype tolerance derivation and output gating",
      "check": "harness/m1.py",
      "gates": [
        {
          "metric": "tolerance_cases_matched",
          "op": ">=",
          "threshold": 6.0
        },
        {
          "metric": "gating_decisions_matched",
          "op": "==",
          "threshold": 1.0
        }
      ]
    },
    {
      "n": 2,
      "title": "Bisect compiled vs eager pipeline divergences",
      "check": "harness/m2.py",
      "gates": [
        {
          "metric": "bisection_accuracy",
          "op": "==",
          "threshold": 1.0
        }
      ]
    },
    {
      "n": 3,
      "title": "Safety net: regression test catches broken tolerance logic",
      "check": "harness/m3.py",
      "gates": [
        {
          "metric": "has_tests",
          "op": "==",
          "threshold": 1.0
        },
        {
          "metric": "passes_on_good",
          "op": "==",
          "threshold": 1.0
        },
        {
          "metric": "catches_broken_tolerance",
          "op": "==",
          "threshold": 1.0
        }
      ]
    }
  ]
}
