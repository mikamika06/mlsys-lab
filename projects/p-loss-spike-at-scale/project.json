{
  "id": "p-loss-spike-at-scale",
  "title": "Стрибки втрат на великому масштабі",
  "kind": "project",
  "tier": "T2",
  "area": "rw3-distributed",
  "track": "",
  "part": 1,
  "difficulty": 4,
  "edits": [
    "system/analysis.py",
    "system/distributed.py",
    "system/train.py",
    "tests/test_regression.py"
  ],
  "milestones": [
    {
      "n": 1,
      "title": "відтворити на записаних логах",
      "check": "harness/m1.py",
      "gates": [
        {
          "metric": "detected_64",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "detected_8",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 2,
      "title": "відокремити дані від числових причин",
      "check": "harness/m2.py",
      "gates": [
        {
          "metric": "invariant_holds",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 3,
      "title": "перевірити детермінізм редукцій",
      "check": "harness/m3.py",
      "gates": [
        {
          "metric": "buggy_fails",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "stable_passes",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 4,
      "title": "знайти операцію, де накопичується похибка",
      "check": "harness/m4.py",
      "gates": [
        {
          "metric": "safe_is_correct",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "safe_is_stable",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 5,
      "title": "стрибки зникають, збіжність збережена",
      "check": "harness/m5.py",
      "gates": [
        {
          "metric": "train_matches",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 6,
      "title": "детектор, що ловить стрибок рано",
      "check": "harness/m6.py",
      "gates": [
        {
          "metric": "has_tests",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "passes_on_good",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "catches_bug",
          "op": "==",
          "threshold": 1
        }
      ]
    }
  ]
}
