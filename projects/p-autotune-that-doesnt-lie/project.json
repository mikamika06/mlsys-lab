          "threshold": 1
        }
      ]
    },
    {
      "n": 2,
      "title": "підібрати ключі",
      "check": "harness/m2.py",
      "gates": [
        {
          "metric": "keys_unique",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 3,
      "title": "коректна методологія вимірювання всередині тюнера",
      "check": "harness/m3.py",
      "gates": [
        {
          "metric": "warmup_and_reps_ok",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 4,
      "title": "перевірити на розподілі реальних форм",
      "check": "harness/m4.py",
      "gates": [
        {
          "metric": "distribution_covered",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 5,
      "title": "обрана конфігурація не гірша за ручну",
