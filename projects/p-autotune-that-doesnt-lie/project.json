      "gates": [
        {
          "metric": "not_worse_than_manual",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 6,
      "title": "час тюнінгу під контролем",
      "check": "harness/m6.py",
      "gates": [
        {
          "metric": "has_tests",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "passes_on_good",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "catches_bad_cache_key",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "catches_fake_timing",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "faults_caught",
