{
  "id": "p-autotune-that-doesnt-lie",
  "title": "A reliable Triton autotuner that respects real shapes",
  "kind": "project",
  "tier": "T1",
  "area": "rw3-triton-real",
  "track": "autotune-that-doesnt-lie",
  "part": 1,
  "difficulty": 5,
  "edits": [
    "autotune/cache.py",
    "autotune/tuner.py",
