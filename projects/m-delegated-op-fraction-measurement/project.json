      "gates": [
        {"metric": "match_xnnpack", "op": "==", "threshold": 1},
        {"metric": "match_coreml", "op": "==", "threshold": 1}
      ]
    },
    {
      "n": 3,
      "title": "Safety net: catch invalid grouping",
      "check": "harness/m3.py",
      "gates": [
        {"metric": "has_tests", "op": "==", "threshold": 1},
        {"metric": "passes_on_good", "op": "==", "threshold": 1},
        {"metric": "catches_invalid_grouping", "op": "==", "threshold": 1}
      ]
    }
  ]
