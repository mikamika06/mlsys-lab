      "n": 1,
      "title": "Parse engine startup logs into phase breakdowns",
      "check": "harness/m1.py",
      "gates": [
        {
          "metric": "logs_parsed",
          "op": ">=",
          "threshold": 3
        }
      ]
    },
    {
      "n": 2,
      "title": "Compute CUDA Graph padding waste and optimize buckets",
      "check": "harness/m2.py",
      "gates": [
        {
          "metric": "waste_matches",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "optimal_buckets_match",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 3,
      "title": "Safety net: regression test catches sub-optimal bucketing",
      "check": "harness/m3.py",
      "gates": [
        {
          "metric": "has_tests",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "passes_on_good",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "catches_bad_buckets",
          "op": "==",
          "threshold": 1
        }
      ]
    }
  ]
}
