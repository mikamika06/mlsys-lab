{
  "id": "m-parse-an-engine-startup-log-into-a-phase-time-breakd",
  "title": "Engine startup log parser and CUDA Graph bucket optimizer",
  "kind": "project",
  "tier": "T0",
  "area": "rw2-vllm-serving",
  "track": "cudagraphs-compile-and-startup-latency",
  "part": 1,
  "difficulty": 3,
  "edits": [
    "engine_diag/startup.py",
    "engine_diag/cudagraph.py",
    "tests/test_regression.py"
