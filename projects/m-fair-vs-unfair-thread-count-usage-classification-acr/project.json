{
  "id": "m-fair-vs-unfair-thread-count-usage-classification-acr",
  "title": "Fair vs unfair thread-count usage classification across recorded runs",
  "kind": "project",
  "tier": "T1",
  "area": "rw3-cpu-inference",
  "track": "Cross-tool CPU inference benchmarking",
  "part": 1,
  "difficulty": 3,
  "edits": [
    "threadperf/classifier.py",
    "threadperf/metrics.py",
    "threadperf/analyzer.py",
    "tests/test_regression.py"
  ],
  "milestones": [
    {
      "n": 1,
      "title": "Classify thread-count usage fairness across recorded runs",
      "check": "harness/m1.py",
      "gates": [
        {"metric": "runs_classified", "op": ">=", "threshold": 5}
      ]
    },
    {
      "n": 2,
      "title": "Compute OpenVINO GenAI vs onnxruntime-genai performance ratios",
      "check": "harness/m2.py",
      "gates": [
        {"metric": "metrics_match", "op": "==", "threshold": 1},
        {"metric": "throughput_valid", "op": "==", "threshold": 1}
      ]
    },
    {
      "n": 3,
      "title": "Safety net: regression test catching incorrect classification boundaries",
      "check": "harness/m3.py",
      "gates": [
        {"metric": "has_tests", "op": "==", "threshold": 1},
        {"metric": "passes_on_good", "op": "==", "threshold": 1},
        {"metric": "catches_invalid_fairness", "op": "==", "threshold": 1}
      ]
    }
  ]
}
