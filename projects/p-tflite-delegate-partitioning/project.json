      "check": "harness/m2.py",
      "gates": [
        {
          "metric": "unsupported_found",
          "op": "==",
          "threshold": 1
        }
      ]
    },
    {
      "n": 3,
      "title": "перебудувати граф під делегат",
      "check": "harness/m3.py",
      "gates": [
        {
          "metric": "fused_subgraphs",
          "op": ">=",
          "threshold": 1
        }
      ]
    },
    {
      "n": 4,
      "title": "виміряти виграш до і після",
      "check": "harness/m4.py",
      "gates": [
        {
          "metric": "speedup_ratio",
          "op": ">",
          "threshold": 1.0
        }
      ]
