          "threshold": 1
        }
      ]
    },
    {
      "n": 3,
      "title": "Safety net: regression test for scheduler policy invariants",
      "check": "harness/m3.py",
      "gates": [
        {
          "metric": "has_tests",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "passes_on_good",
          "op": "==",
          "threshold": 1
        },
        {
          "metric": "catches_broken_policy",
          "op": "==",
