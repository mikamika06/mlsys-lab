       {"metric": "reps_match", "op": "==", "threshold": 1}]},
    {"n": 2, "title": "Statistics that can say no", "check": "harness/m2.py",
     "gates": [
       {"metric": "median_match", "op": "==", "threshold": 1},
       {"metric": "iqr_match", "op": "==", "threshold": 1},
       {"metric": "separable_match", "op": "==", "threshold": 1},
       {"metric": "separable_uses_iqr", "op": "==", "threshold": 1}]},
    {"n": 3, "title": "Which comparisons are controlled", "check": "harness/m3.py",
     "gates": [
       {"metric": "differences_match", "op": "==", "threshold": 1},
       {"metric": "controlled_found", "op": "==", "threshold": 1},
       {"metric": "confounded_found", "op": "==", "threshold": 1}]},
    {"n": 4, "title": "Throughput against context depth", "check": "harness/m4.py",
