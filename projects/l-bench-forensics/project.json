       {"metric": "floor_respected", "op": "==", "threshold": 1},
       {"metric": "bandwidth_order", "op": "==", "threshold": 1}]},
    {"n": 6, "title": "An audit that stays quiet on clean data", "check": "harness/m6.py",
     "gates": [
