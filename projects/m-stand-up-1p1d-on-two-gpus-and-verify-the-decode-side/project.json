{
  "id": "m-stand-up-1p1d-on-two-gpus-and-verify-the-decode-side",
  "title": "Stand up 1P1D on two GPUs and verify the decode side",
  "kind": "project",
  "tier": "T3",
  "area": "rw2-vllm-serving",
  "track": "disaggregated-prefill-decode-and-kv-connectors",
  "part": 1,
  "difficulty": 3,
  "edits": [
    "disagg/p1d.py",
    "disagg/verify.py",
    "tests/test_regression.py"
