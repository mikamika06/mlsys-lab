        {"metric": "fcfs_wait_err", "op": "==", "threshold": 0.0}
      ]
    },
    {
      "n": 2,
      "title": "Eviction Policies (LRU, LFU, LUS)",
      "check": "harness/m2.py",
      "gates": [
        {"metric": "lru_rel_err", "op": "<=", "threshold": 0.01},
        {"metric": "lfu_rel_err", "op": "<=", "threshold": 0.01},
        {"metric": "lus_rel_err", "op": "<=", "threshold": 0.01}
      ]
    },
    {
      "n": 3,
      "title": "HiCache Tiering",
      "check": "harness/m3.py",
      "gates": [
        {"metric": "gpu_hit_rel_err", "op": "<=", "threshold": 0.01},
        {"metric": "host_hit_rel_err", "op": "<=", "threshold": 0.01},
        {"metric": "has_tests", "op": "==", "threshold": 1},
        {"metric": "passes_on_good", "op": "==", "threshold": 1},
        {"metric": "catches_broken_tiering", "op": "==", "threshold": 1}
      ]
    }
  ]
