      "check": "harness/m2.py",
      "gates": [
        {"metric": "memory_matched", "op": "==", "threshold": 1},
        {"metric": "roofline_matched", "op": "==", "threshold": 1}
      ]
    },
    {
      "n": 3,
      "title": "Safety net: regression tests catch faulty arithmetic",
      "check": "harness/m3.py",
      "gates": [
        {"metric": "has_tests", "op": "==", "threshold": 1},
        {"metric": "passes_on_good", "op": "==", "threshold": 1},
        {"metric": "catches_missing_kv_flops", "op": "==", "threshold": 1}
      ]
    }
  ]
}
