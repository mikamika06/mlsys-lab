      ]
    },
    {
      "n": 3,
      "title": "Safety net: test suite catching flawed routing definitions",
      "check": "harness/m3.py",
      "gates": [
        {"metric": "has_tests", "op": "==", "threshold": 1},
        {"metric": "passes_on_good", "op": "==", "threshold": 1},
        {"metric": "catches_bad_routing", "op": "==", "threshold": 1}
