{
  "id": "p-hybrid-sliding-window-cache",
  "title": "Hybrid KV Cache for Mixed Attention Layers",
  "kind": "project",
  "tier": "T0",
  "area": "rw2-kv-cache-serving",
  "track": "hybrid-sliding-window-cache",
  "part": 1,
  "difficulty": 3,
  "edits": [
    "kvcache/config.py",
    "kvcache/cache.py",
    "kvcache/engine.py",
    "tests/test_regression.py"
  ],
  "milestones": [
    {
      "n": 1,
      "title": "описати вимогу кожного шару",
      "check": "harness/m1.py",
      "gates": [
        {
          "metric": "config_parsed",
          "op": "==",
          "threshold": 1.0
        },
        {
          "metric": "layer_types_valid",
          "op": "==",
          "threshold": 1.0
        },
        {
          "metric": "window_sizes_valid",
          "op": "==",
          "threshold": 1.0
        }
      ]
    },
    {
      "n": 2,
      "title": "реалізувати гібридне керування",
      "check": "harness/m2.py",
      "gates": [
        {
          "metric": "sliding_layer_capped",
          "op": "==",
          "threshold": 1.0
        },
        {
          "metric": "full_layer_unbounded",
          "op": "==",
          "threshold": 1.0
        },
        {
          "metric": "kv_contents_correct",
          "op": "==",
          "threshold": 1.0
        }
      ]
    },
    {
      "n": 3,
      "title": "перевірити еквівалентність виходу",
      "check": "harness/m3.py",
      "gates": [
        {
          "metric": "attention_outputs_match",
          "op": "==",
          "threshold": 1.0
        },
        {
          "metric": "logits_match",
          "op": "==",
          "threshold": 1.0
        }
      ]
    },
    {
      "n": 4,
      "title": "виміряти економію",
      "check": "harness/m4.py",
      "gates": [
        {
          "metric": "memory_measured",
          "op": "==",
          "threshold": 1.0
        },
        {
          "metric": "saving_ratio_correct",
          "op": "==",
          "threshold": 1.0
        }
      ]
    },
    {
      "n": 5,
      "title": "економія вище порога, вихід збігається",
      "check": "harness/m5.py",
      "gates": [
        {
          "metric": "memory_saving_above_threshold",
          "op": ">=",
          "threshold": 0.35
        },
        {
          "metric": "output_equivalence",
          "op": "==",
          "threshold": 1.0
        }
      ]
    },
    {
      "n": 6,
      "title": "поведінка на межі вікна визначена",
      "check": "harness/m6.py",
      "gates": [
        {
          "metric": "has_tests",
          "op": "==",
          "threshold": 1.0
        },
        {
          "metric": "passes_on_good",
          "op": "==",
          "threshold": 1.0
        },
        {
          "metric": "catches_sliding_boundary_fault",
          "op": "==",
          "threshold": 1.0
        },
        {
          "metric": "catches_full_layer_truncation_fault",
          "op": "==",
          "threshold": 1.0
        },
        {
          "metric": "faults_caught",
          "op": ">=",
          "threshold": 2.0
        }
      ]
    }
  ]
}
